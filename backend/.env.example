# === NEXUS AI — Backend ===
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env (já está no .gitignore).

# Chave da Groq (https://console.groq.com/keys)
GROQ_API_KEY=

# Modelos
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# Segurança
JWT_SECRET=gere-um-segredo-forte-aqui-mude-isso
# Frase de acesso do dono (usada para obter o token no app/login)
OWNER_PASSPHRASE=nexus

# Banco (SQLite por padrão — troque por PostgreSQL em produção)
DATABASE_URL=sqlite:///./nexus.db

# Provedor de TTS: android (usa TTS do celular) | openai | piper
TTS_PROVIDER=android
OPENAI_TTS_API_KEY=

# Spotify (crie um app em https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=nexusai://spotify/callback

# Host/porta
HOST=0.0.0.0
PORT=8000
