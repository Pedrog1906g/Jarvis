# === NEXUS AI — Backend ===
# Copie este arquivo para .env e preencha os valores.
# NUNCA comite o .env (já está no .gitignore).

# --- LLM Provider ---
# Escolha o provedor: groq | openai | ollama | anthropic | google
LLM_PROVIDER=groq

# --- Groq (padrão) ---
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_STT_MODEL=whisper-large-v3

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# --- Anthropic (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# --- Google (Gemini) ---
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash-exp

# Segurança
JWT_SECRET=gere-um-segredo-forte-aqui-mude-isso
# Frase de acesso do dono (usada para obter o token no app/login)
OWNER_PASSPHRASE=nexus

# Firebase (OPCIONAL — preencha no Render, nunca no APK)
# Gere em: Firebase Console → Project Settings → Service accounts → Generate new private key
# O JSON baixado fornece project_id, client_email e private_key.
# ATENÇÃO: a private_key contém "\n" — cole exatamente como está.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
# jwt = login padrão (owner/passphrase). firebase = usar Firebase Auth como ponte.
AUTH_MODE=jwt

# Banco (SQLite por padrão — troque por PostgreSQL em produção)
DATABASE_URL=sqlite:///./nexus.db

# Provedor de TTS: android (usa TTS do celular) | openai | piper
TTS_PROVIDER=android
OPENAI_TTS_API_KEY=

# Piper TTS offline (https://github.com/rhasspy/piper)
# Baixe o modelo PT-BR em: https://huggingface.co/rhasspy/piper-voices/tree/main/pt/pt_BR
# Recomendado: pt_BR-faber-medium.onnx
PIPER_MODEL_PATH=
PIPER_EXECUTABLE=piper

# Spotify (crie um app em https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
SPOTIFY_REDIRECT_URI=nexusai://spotify/callback

# --- Obsidian (segundo cérebro / análise de dados) ---
# Instale o plugin "Local REST API" no Obsidian e cole a chave aqui
# (ou configue pelo app em Ajustes → Obsidian). Funciona quando o backend
# consegue alcançar o Obsidian (backend no mesmo PC, ou Obsidian exposto).
OBSIDIAN_API_KEY=
OBSIDIAN_API_URL=http://127.0.0.1:27123
# OU use um vault local (pasta de arquivos .md no servidor):
OBSIDIAN_VAULT_PATH=

# Host/porta
HOST=0.0.0.0
PORT=8000
